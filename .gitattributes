# Los archivos con huella SHA-256 se guardan y se bajan byte a byte: sin esto, Git en Windows convierte los saltos de
# línea al clonar y la huella de data/checksums.json deja de coincidir.
data/checksums.json -text
data/processed/* -text

# El registro de experimentos solo crece: si dos ramas agregan filas, el merge local conserva las de ambas.
results/experiment_logs.csv -text merge=union
