# Los archivos con huella SHA-256 se guardan y se bajan byte a byte: sin esto, Git en Windows convierte los saltos de
# línea al clonar y la huella de data/checksums.json deja de coincidir.
data/checksums.json -text
data/processed/* -text

# El registro de experimentos solo crece: si dos ramas agregan filas, el merge local conserva las de ambas.
results/experiment_logs.csv -text merge=union

# LightGBM: preservar bytes y hashes de los ejecutores y la evidencia histórica.
src/modelado_lightgbm.py -text
src/modelado_lightgbm_2.py -text
src/comparar_lightgbm.py -text
results/lightgbm/** -text
results/lightgbm_2/** -text
models/lightgbm/** -text
models/lightgbm_2/** -text

# Cierre Lasso: conservar huellas y predicciones auditables entre plataformas.
src/train_model.py -text
src/informe_lasso_final.py -text
results/lasso_final/** -text
models/model_registry.json -text
