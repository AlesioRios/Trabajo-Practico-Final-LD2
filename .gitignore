# Fase 2.3: las ejecuciones completas se conservan comprimidas en historial/.
# Se dejan visibles los artefactos que consume el notebook y las reglas originales.
/results/seleccion/ejecucion-20261113T184058Z-969d4545/*
!/results/seleccion/ejecucion-20261113T184058Z-969d4545/selecciones_por_metodo.json
!/results/seleccion/ejecucion-20261113T184058Z-969d4545/configuraciones.json
!/results/seleccion/ejecucion-20261113T184058Z-969d4545/datos.json
!/results/seleccion/ejecucion-20261113T184058Z-969d4545/preparacion/
/results/seleccion/ejecucion-20261113T184058Z-969d4545/preparacion/*
!/results/seleccion/ejecucion-20261113T184058Z-969d4545/preparacion/final.json
/results/seleccion/ejecucion-20261113T194441Z-union-a9b63e4f/
/results/seleccion/ejecucion-forward30-20261113-01/
